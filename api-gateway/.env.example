# --- API Gateway Environment Variables ---

# Server Config
PORT=5000
NODE_ENV=development

# AI Service Connection — the ai-service FastAPI app (Phases 7-8). Used by
# services/ai.service.js for POST /v1/extract-surface and POST /v1/assess.
AI_SERVICE_DEV_URL=http://127.0.0.1:8000
AI_SERVICE_PRO_URL=https://your-ai-service.onrender.com

# Supabase Configuration & Authentication
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-share
# Not read by middlewares/auth.middleware.js — it verifies session JWTs against
# Supabase's published JWKS (derived from SUPABASE_URL), not this shared secret.
# Kept here only in case a future change opts back into HMAC verification.
SUPABASE_JWT_SECRET=your-super-secret-jwt-string

# Core Databases (Relational & Graph)
# IMPORTANT: Use the IPv4 connection pooler port (6543) for Node.js API Gateway to prevent connection exhaustion
DATABASE_URL=postgresql://postgres.xxx:[YOUR-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Neo4j Graph Database Connection
NEO4J_URI=neo4j+s://xxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# GitHub OAuth for repo importing
GITHUB_CLIENT_ID=your_github_oauth_id
GITHUB_CLIENT_SECRET=your_github_oauth_secret
