
# Server Config
PORT=8000

# Core Database & Storage (Supabase)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-share
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres

# Graph Database (Neo4j)
NEO4J_URI=neo4j+s://xxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# AI Engine API (OpenRouter primary, Gemini fallback, Hugging Face embeddings)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxx
GEMINI_API_KEY=your_gemini_api_key
HUGGINGFACE_API_KEY=hf_xxxxxxxxxx

# Asynchronous Task Queue (Upstash Redis for Celery)
CELERY_BROKER_URL=rediss://default:PASSWORD@xxx.upstash.io:6379?ssl_cert_reqs=CERT_NONE
CELERY_RESULT_BACKEND=rediss://default:PASSWORD@xxx.upstash.io:6379?ssl_cert_reqs=CERT_NONE
