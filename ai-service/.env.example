
# ai-service owns prompts and model calls only (phases/Phase_07.md §2). It
# holds no database credentials — api-gateway assembles context from
# Postgres/Neo4j/GitHub and sends everything this service needs in the
# request body.

# Server config
PORT=8000

# Gemini API — Gemma 4, the primary inference path for both the Best Use of
# Gemma 4 and Best Open-Source AI Project challenges (docs/AI_DESIGN.md §7).
GEMINI_API_KEY=your_gemini_api_key
GEMMA_MODEL_EXTRACT=gemma-4-26b-a4b-it
GEMMA_MODEL_REASON=gemma-4-31b-it

# Optional local mode (phases/Phase_10.md §1) — not wired into the engine
# yet; reserved so the provider switch exists ahead of that build.
LLM_PROVIDER=gemini
OLLAMA_BASE_URL=http://localhost:11434

# Fallback only. Never the documented primary path — see AI_DESIGN.md §7.1.
OPENROUTER_API_KEY=
