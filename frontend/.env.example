# --- Frontend Environment Variables ---

# API Gateway URLs
# Match api-gateway/.env.example's PORT (5000 by default there) — a mismatch
# here is the most common "frontend can't reach the API" setup mistake.
VITE_API_DEV_URL=http://localhost:5000
VITE_API_PRO_URL=https://project_name.onrender.com

# Execution Mode (development | production)
VITE_MODE=development

# Supabase Auth & Database (Public Keys)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
